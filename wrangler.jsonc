{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loot-up",
  "account_id": "567d0185b1b286ef05d53aa6834a7635",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./",
